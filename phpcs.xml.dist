<?xml version="1.0"?>
<ruleset name="cor-mgmt foundation">
    <description>WordPress security and translation rules for the new foundation.</description>
    <config name="installed_paths" value="vendor/wp-coding-standards/wpcs,vendor/phpcsstandards/phpcsutils,vendor/phpcsstandards/phpcsextra,vendor/phpcompatibility/php-compatibility,vendor/phpcompatibility/phpcompatibility-wp,vendor/phpcompatibility/phpcompatibility-paragonie"/>
    <arg name="extensions" value="php"/>
    <file>src</file>
    <file>uninstall.php</file>
    <rule ref="PSR12"><exclude name="Generic.Files.LineLength"/></rule>
    <rule ref="WordPress.Security.EscapeOutput"/>
    <rule ref="WordPress.DB.PreparedSQL"/>
    <rule ref="WordPress.WP.I18n"/>
    <rule ref="Generic.PHP.DisallowAlternativePHPTags"/>
    <config name="text_domain" value="h3-mgmt"/>
</ruleset>

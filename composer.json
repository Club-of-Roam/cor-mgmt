{
  "name": "club-of-roam/cor-mgmt",
  "description": "Development tooling for cor-mgmt modernization; runtime remains legacy until migrated.",
  "type": "wordpress-plugin",
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": false,
    "platform": {
      "php": "8.2.0"
    }
  },
  "scripts": {
    "test": "@php vendor/phpunit/phpunit/phpunit",
    "check": [
      "@composer validate --strict",
      "@php tools/lint.php",
      "@php tools/check-docs.php"
    ]
  },
  "license": "GPL-3.0-only"
}

{
  "name": "club-of-roam/cor-mgmt",
  "description": "WordPress event management with modular adapters and development tooling.",
  "type": "wordpress-plugin",
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "php-stubs/wordpress-stubs": "^6.0 || ^7.0",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5",
    "wp-coding-standards/wpcs": "^3.0"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": false,
    "platform": {
      "php": "8.2.0"
    }
  },
  "scripts": {
    "test": "@php vendor/phpunit/phpunit/phpunit",
    "test:integration": "@php vendor/phpunit/phpunit/phpunit -c phpunit.integration.xml.dist",
    "check": [
      "@composer validate --strict",
      "@php tools/lint.php",
      "@php tools/check-docs.php",
      "@php tools/export-schema.php --check",
      "@php tools/export-schema.php --participation --check",
      "@php tools/export-schema.php --results --check",
      "@analyse",
      "@lint:standards",
      "@lint:compatibility"
    ],
    "test:js": "node --test tests/security-js.test.cjs tests/schema-js.test.cjs",
    "analyse": "@php vendor/phpstan/phpstan/phpstan analyse --no-progress --memory-limit=512M",
    "lint:standards": "@php vendor/squizlabs/php_codesniffer/bin/phpcs -s",
    "lint:compatibility": "@php vendor/squizlabs/php_codesniffer/bin/phpcs --standard=phpcs-compatibility.xml.dist",
    "lint:js": "npm run lint",
    "build": "@php tools/build-package.php"
  },
  "license": "GPL-3.0-only",
  "autoload": {
    "psr-4": {
      "Cor\\Mgmt\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Cor\\Mgmt\\Tests\\": "tests/"
    }
  }
}
